---
import { ArrowRight, Briefcase, Building2, Globe, GraduationCap, Handshake } from "lucide-react";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PageHeader } from "@/components/ui/PageHeader";
import { institucionesConvenio, mecanismosVinculacion } from "@/data/vinculacion";

const iconMap = {
  universidad: GraduationCap,
  gobierno: Building2,
  empresa: Briefcase,
  organismo: Globe,
} as const;

const tituloTipo = {
  universidad: "Universidades",
  gobierno: "Gobierno",
  empresa: "Empresas",
  organismo: "Organismos",
} as const;

/*
 * Se recorren TODOS los tipos declarados en el modelo de datos. La version
 * anterior iteraba una lista fija sin "empresa", de modo que cualquier convenio
 * empresarial que se cargara despues habria desaparecido en silencio.
 */
const tipos = ["universidad", "gobierno", "empresa", "organismo"] as const;

const grupos = tipos
  .map((tipo) => ({
    tipo,
    titulo: tituloTipo[tipo],
    Icono: iconMap[tipo],
    instituciones: institucionesConvenio.filter((item) => item.tipo === tipo),
  }))
  .filter((grupo) => grupo.instituciones.length > 0);

// Con un numero impar de elementos, el ultimo ocupa las dos columnas y la
// reticula no queda con un hueco al final.
const mecanismosImpares = mecanismosVinculacion.length % 2 === 1;
---

<BaseLayout
  title="MDO UAGro | Vinculación"
  description="Mecanismos de vinculación y convenios de colaboración de la MDO UAGro."
>
  <PageHeader
    title="Vinculación"
    subtitle="Mecanismos de colaboración y convenios con instituciones nacionales e internacionales"
  />

  <section class="py-12">
    <div class="mx-auto max-w-6xl px-4 space-y-12">
      <div class="rounded-2xl border border-border bg-card p-8 shadow-sm">
        <div class="flex flex-col items-start gap-4 sm:flex-row">
          <div class="rounded-xl bg-primary/10 p-3">
            <Handshake className="h-6 w-6 text-primary" aria-hidden="true" />
          </div>
          <div>
            <h2 class="mb-3 font-display text-xl font-semibold text-foreground">
              Vinculación institucional
            </h2>
            <p class="leading-relaxed text-muted-foreground">
              La Maestría en Dirección de Organizaciones mantiene vínculos
              activos con instituciones educativas, organismos gubernamentales y
              empresas a nivel nacional e internacional. Estos convenios permiten
              el intercambio académico, la investigación conjunta, estancias
              profesionales y la realización de proyectos de colaboración que
              enriquecen la formación de nuestros estudiantes.
            </p>
          </div>
        </div>
      </div>

      <section aria-labelledby="mecanismos">
        <h2
          id="mecanismos"
          class="mb-6 font-display text-2xl font-semibold text-foreground"
        >
          Mecanismos de vinculación
        </h2>
        <ul class="grid auto-rows-fr gap-6 sm:grid-cols-2">
          {
            mecanismosVinculacion.map((mecanismo, indice) => {
              const ultimo = indice === mecanismosVinculacion.length - 1;
              return (
                <li
                  class:list={[
                    "h-full",
                    mecanismosImpares && ultimo && "sm:col-span-2",
                  ]}
                >
                  <article class="flex h-full flex-col rounded-2xl border border-border bg-card p-6 transition-shadow hover:shadow-md">
                    <div class="mb-3 flex items-center gap-2 text-primary">
                      <ArrowRight className="h-4 w-4" aria-hidden="true" />
                      <h3 class="font-semibold">{mecanismo.titulo}</h3>
                    </div>
                    <p class="text-sm leading-relaxed text-muted-foreground">
                      {mecanismo.descripcion}
                    </p>
                  </article>
                </li>
              );
            })
          }
        </ul>
      </section>

      <section aria-labelledby="convenios">
        <h2
          id="convenios"
          class="mb-6 font-display text-2xl font-semibold text-foreground"
        >
          Instituciones con convenio
        </h2>

        {
          grupos.map((grupo) => (
            <div class="mb-8 last:mb-0">
              <h3 class="mb-4 flex items-center gap-2 font-semibold text-foreground">
                <grupo.Icono className="h-5 w-5 text-accent" aria-hidden="true" />
                {grupo.titulo}
              </h3>
              {/*
                Dos columnas en vez de tres: con 10 universidades, 2 dependencias
                de gobierno y 2 organismos, la reticula de tres dejaba un
                elemento huerfano en cada uno de los tres bloques.
              */}
              <ul class="grid gap-3 sm:grid-cols-2">
                {grupo.instituciones.map((institucion) => (
                  <li class="rounded-xl bg-muted/50 p-4 text-sm">
                    <p class="font-medium text-foreground">{institucion.nombre}</p>
                    {institucion.pais && (
                      <p class="mt-1 text-xs text-muted-foreground">
                        {institucion.pais}
                      </p>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }

        <p class="mt-8 rounded-xl bg-accent/10 p-4 text-center text-sm text-accent">
          Esta lista representa una muestra de los convenios activos. Para más
          información, contacta a la coordinación del programa.
        </p>
      </section>
    </div>
  </section>
</BaseLayout>
