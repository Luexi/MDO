---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PageHeader } from "@/components/ui/PageHeader";
import TesisFiltro from "@/components/islands/TesisFiltro";
import { generaciones, tesis } from "@/data/tesis";
---

<BaseLayout
  title="MDO UAGro | Tesis"
  description="Trabajos de grado de las y los egresados de la Maestría en Dirección de Organizaciones, por generación."
>
  <PageHeader
    title="Tesis"
    subtitle="Trabajos de investigación de nuestras generaciones de egreso"
  />

  <section class="py-12" aria-labelledby="trabajos">
    <div class="mx-auto max-w-6xl px-4">
      <h2 id="trabajos" class="sr-only">Trabajos de grado por generación</h2>
      <TesisFiltro generaciones={generaciones} tesis={tesis} client:idle />
    </div>
  </section>
</BaseLayout>
