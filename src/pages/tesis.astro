---
import { BookOpen, Clock } from "lucide-react";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PageHeader } from "@/components/ui/PageHeader";
import { TesisCard } from "@/components/cards/TesisCard";
import { generaciones, tesis } from "@/data/tesis";

/*
 * Las tres generaciones se renderizan en el servidor y el script solo conmuta
 * `hidden`. Antes esto era una isla React (`TesisFiltro.tsx`) que traia 54 KB
 * comprimidos de framework a la pagina para gestionar una sola cadena de
 * estado. Ver `src/scripts/filtroTesis.ts`.
 */
const porGeneracion = generaciones.map((generacion) => ({
  ...generacion,
  trabajos: tesis.filter((item) => item.generacion === generacion.id),
}));
---

<BaseLayout
  title="MDO UAGro | Tesis"
  description="Trabajos de grado de las y los egresados de la Maestría en Dirección de Organizaciones, por generación."
>
  <PageHeader
    title="Tesis"
    subtitle="Trabajos de investigación de nuestras generaciones de egreso"
  />

  <section class="py-12">
    <div class="mx-auto max-w-6xl px-4" data-filtro-tesis>
      <div
        class="mb-10 flex flex-wrap justify-center gap-3"
        role="group"
        aria-label="Filtrar tesis por generación"
        data-filtro-barra
      >
        {
          porGeneracion.map((generacion, indice) => (
            <button
              type="button"
              data-filtro-boton
              data-generacion={generacion.id}
              aria-pressed={indice === 0 ? "true" : "false"}
              class="h-11 rounded-xl border border-border bg-card px-5 font-medium text-foreground transition-colors hover:bg-muted aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-foreground aria-pressed:shadow-md"
            >
              Generación {generacion.label}
            </button>
          ))
        }
      </div>

      {
        porGeneracion.map((generacion, indice) => (
          <div
            data-filtro-panel
            data-generacion={generacion.id}
            hidden={indice !== 0}
          >
            <h2 class="mb-6 text-center font-display text-2xl font-semibold text-foreground">
              Generación {generacion.label}
            </h2>

            {generacion.trabajos.length > 0 ? (
              <ul class="grid auto-rows-fr gap-6 md:grid-cols-2">
                {generacion.trabajos.map((item) => (
                  <li class="h-full">
                    <TesisCard tesis={item} />
                  </li>
                ))}
              </ul>
            ) : (
              <div class="py-16 text-center">
                <div class="mx-auto mb-4 w-fit rounded-full bg-muted p-4">
                  <Clock
                    className="h-12 w-12 text-muted-foreground"
                    aria-hidden="true"
                  />
                </div>
                <h3 class="mb-2 font-display text-xl font-semibold text-foreground">
                  Próximamente
                </h3>
                <p class="mx-auto max-w-md text-muted-foreground">
                  Los trabajos de tesis de esta generación estarán disponibles
                  una vez que los estudiantes concluyan su proceso de
                  titulación.
                </p>
              </div>
            )}
          </div>
        ))
      }

      {/*
        `text-foreground/80` y no `text-muted-foreground`: sobre `bg-primary/5`
        ese token cae a 4.46:1, por debajo del minimo AA. Ver la nota de
        `--muted-foreground` en global.css.

        El texto anterior afirmaba que "los documentos estan disponibles en
        formato PDF a traves de Google Drive". Ninguna de las cinco tesis tiene
        hoy enlace publicado: las cinco se muestran "En proceso". La afirmacion
        contradecia lo que la propia pagina enseña.
      */}
      <div class="mt-12 rounded-2xl bg-primary/5 p-8">
        <div class="flex items-start gap-4">
          <BookOpen
            className="h-8 w-8 flex-shrink-0 text-primary"
            aria-hidden="true"
          />
          <div>
            <h2 class="mb-2 font-display text-lg font-semibold text-foreground">
              Sobre el repositorio
            </h2>
            <p class="text-sm leading-relaxed text-foreground/80">
              Aquí se registran los trabajos de grado de las y los egresados de
              la Maestría en Dirección de Organizaciones. Los que ya tienen
              documento publicado incluyen el enlace de descarga; el resto
              aparece como «En proceso» hasta que la coordinación lo entregue.
              Para citarlos, consulta los lineamientos APA vigentes.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/*
    Sin JavaScript no hay conmutacion posible, asi que se revelan todos los
    paneles y se oculta la barra. Cada generacion conserva su encabezado, de
    modo que la pagina se sigue leyendo.
  */}
  <noscript>
    <style>
      [data-filtro-panel][hidden] {
        display: block !important;
      }
      [data-filtro-barra] {
        display: none !important;
      }
    </style>
  </noscript>
</BaseLayout>
