---
import {
  AlertCircle,
  Calendar,
  CheckCircle,
  Clock,
  FileText,
  HelpCircle,
  Info,
  Mail,
  Phone,
  Scale,
  Users,
} from "lucide-react";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PageHeader } from "@/components/ui/PageHeader";
import { Button } from "@/components/ui/button";
import {
  calendarioAdmision,
  convocatoriaVigente,
  criteriosSeleccion,
  dirigidoA,
  preguntasFrecuentes,
  requisitosAdmision,
} from "@/data/admision";
import { contacto } from "@/data/contacto";
import { withBase } from "@/lib/paths";
---

<BaseLayout
  title="MDO UAGro | Convocatoria"
  description="Convocatoria de la MDO UAGro: calendario, requisitos, criterios de selección, preguntas frecuentes y contacto de la coordinación."
>
  <PageHeader
    title="Convocatoria"
    subtitle={`Calendario, requisitos y criterios de selección · ${convocatoriaVigente.generacion}`}
  />

  <section class="py-12">
    <div class="mx-auto max-w-5xl px-4">
      {/*
        El calendario, los requisitos y la ponderacion se publican en HTML,
        tomados del cartel oficial, que es la fuente rectora. Antes solo existian
        dentro de la imagen: ilegibles a 390 px y fuera del alcance de un lector
        de pantalla.
      */}
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem]">
        <div class="space-y-12">
          {
            convocatoriaVigente.cerrada && (
              <div class="flex items-start gap-4 rounded-2xl border border-border bg-muted/60 p-5">
                <Info
                  className="mt-0.5 h-5 w-5 flex-shrink-0 text-muted-foreground"
                  aria-hidden="true"
                />
                <div>
                  <h2 class="font-semibold text-foreground">
                    Proceso de selección concluido
                  </h2>
                  <p class="mt-1 text-sm text-muted-foreground">
                    {convocatoriaVigente.nota}
                  </p>
                </div>
              </div>
            )
          }

          <section aria-labelledby="perfil-titulo">
            <h2
              id="perfil-titulo"
              class="mb-4 flex items-center gap-3 font-display text-2xl font-semibold text-foreground"
            >
              <Users className="h-6 w-6 text-primary" aria-hidden="true" />
              A quién va dirigida
            </h2>
            <p class="leading-relaxed text-muted-foreground">{dirigidoA}</p>
            <p class="mt-3 text-sm text-muted-foreground">
              Modalidad: <strong class="font-medium text-foreground">
                {convocatoriaVigente.modalidad}
              </strong>
            </p>
          </section>

          <section aria-labelledby="calendario-titulo">
            <h2
              id="calendario-titulo"
              class="mb-6 flex items-center gap-3 font-display text-2xl font-semibold text-foreground"
            >
              <Calendar className="h-6 w-6 text-primary" aria-hidden="true" />
              Calendario del proceso
            </h2>

            <ol class="space-y-0">
              {
                calendarioAdmision.map((item, index) => (
                  <li class="relative pb-8 pl-8 last:pb-0">
                    {index !== calendarioAdmision.length - 1 && (
                      <span
                        class="absolute left-[11px] top-6 h-full w-0.5 bg-border"
                        aria-hidden="true"
                      />
                    )}
                    <span
                      class:list={[
                        "absolute left-0 top-1 flex h-6 w-6 items-center justify-center rounded-full",
                        item.activo
                          ? "bg-primary"
                          : "border-2 border-border bg-muted",
                      ]}
                      aria-hidden="true"
                    >
                      {item.activo && (
                        <Clock className="h-3 w-3 text-primary-foreground" />
                      )}
                    </span>
                    <div class="ml-4">
                      <p
                        class:list={[
                          "text-sm font-medium",
                          item.activo ? "text-primary" : "text-muted-foreground",
                        ]}
                      >
                        {item.fecha}
                        {item.activo && (
                          <span class="ml-2 rounded-full bg-primary/10 px-2 py-0.5 text-xs">
                            Etapa vigente
                          </span>
                        )}
                      </p>
                      <h3 class="mt-1 font-semibold text-foreground">
                        {item.evento}
                      </h3>
                      <p class="mt-1 text-sm text-muted-foreground">
                        {item.descripcion}
                      </p>
                    </div>
                  </li>
                ))
              }
            </ol>
          </section>

          <section aria-labelledby="criterios-titulo">
            <h2
              id="criterios-titulo"
              class="mb-6 flex items-center gap-3 font-display text-2xl font-semibold text-foreground"
            >
              <Scale className="h-6 w-6 text-primary" aria-hidden="true" />
              Criterios de selección
            </h2>
            <table class="w-full text-sm">
              <caption class="sr-only">
                Ponderación de cada criterio en el proceso de selección.
              </caption>
              <thead>
                <tr class="border-b border-border text-muted-foreground">
                  <th scope="col" class="py-2 pr-3 text-left font-medium">
                    Criterio
                  </th>
                  <th scope="col" class="py-2 pl-3 text-right font-medium">
                    Ponderación
                  </th>
                </tr>
              </thead>
              <tbody>
                {
                  criteriosSeleccion.map((criterio) => (
                    <tr class="border-b border-border/70 last:border-b-0">
                      <td class="py-3 pr-3 text-foreground/90">
                        {criterio.criterio}
                      </td>
                      <td class="py-3 pl-3 text-right font-semibold text-foreground">
                        {criterio.ponderacion}%
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </section>

          <section aria-labelledby="requisitos-titulo" id="requisitos">
            <h2
              id="requisitos-titulo"
              class="mb-6 flex items-center gap-3 font-display text-2xl font-semibold text-foreground"
            >
              <CheckCircle className="h-6 w-6 text-primary" aria-hidden="true" />
              Requisitos de admisión
            </h2>
            <ul class="grid gap-3 sm:grid-cols-2">
              {
                requisitosAdmision.map((requisito) => (
                  <li class="flex items-start gap-3 rounded-xl bg-muted/50 p-3">
                    <CheckCircle
                      className="mt-0.5 h-5 w-5 flex-shrink-0 text-accent"
                      aria-hidden="true"
                    />
                    <span class="text-sm text-foreground/90">{requisito}</span>
                  </li>
                ))
              }
            </ul>
          </section>

          <div
            class="flex items-start gap-4 rounded-2xl border border-destructive/20 bg-destructive/10 p-6"
          >
            <AlertCircle
              className="h-6 w-6 flex-shrink-0 text-destructive"
              aria-hidden="true"
            />
            <div>
              <h2 class="mb-2 font-semibold text-foreground">
                Becas nacionales de posgrado
              </h2>
              <p class="text-sm text-muted-foreground">
                Estar admitido en un posgrado no garantiza la asignación de una
                beca. Las becas las asigna SECIHTI en dependencia del
                presupuesto federal.
              </p>
            </div>
          </div>

          <section aria-labelledby="faq-titulo" id="preguntas-frecuentes">
            <h2
              id="faq-titulo"
              class="mb-6 flex items-center gap-3 font-display text-2xl font-semibold text-foreground"
            >
              <HelpCircle className="h-6 w-6 text-primary" aria-hidden="true" />
              Preguntas frecuentes
            </h2>

            {/*
              `details`/`summary` nativos: plegables, operables con teclado y
              anunciados correctamente por lectores de pantalla sin una linea de
              JavaScript ni atributos ARIA propios.
            */}
            <div class="divide-y divide-border overflow-hidden rounded-2xl border border-border bg-card">
              {
                preguntasFrecuentes.map((item) => (
                  <details class="group">
                    <summary class="flex cursor-pointer items-center justify-between gap-4 p-5 font-medium text-foreground marker:content-none">
                      {item.pregunta}
                      <span
                        class="flex-shrink-0 text-xl leading-none text-muted-foreground transition-transform group-open:rotate-45"
                        aria-hidden="true"
                      >
                        +
                      </span>
                    </summary>
                    <p class="px-5 pb-5 text-sm leading-relaxed text-muted-foreground">
                      {item.respuesta}
                    </p>
                  </details>
                ))
              }
            </div>
          </section>
        </div>

        <aside class="space-y-6 lg:sticky lg:top-28 lg:self-start">
          <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
            <img
              src={withBase("/convocatoria.webp")}
              alt="Cartel oficial de la convocatoria de la Maestría en Dirección de Organizaciones, generación febrero 2026"
              width="847"
              height="1200"
              loading="lazy"
              class="w-full"
            />
            <div class="space-y-3 p-4">
              <p class="text-xs text-muted-foreground">
                Documento oficial. Los datos de esta página se toman de él.
              </p>
              <a
                href={withBase("/convocatoria.webp")}
                target="_blank"
                rel="noopener noreferrer"
                class="block"
              >
                <Button variant="outline" size="sm" className="w-full gap-2 rounded-xl">
                  <FileText className="h-4 w-4" />
                  Ver cartel completo
                  <span class="sr-only">, se abre en una pestaña nueva</span>
                </Button>
              </a>
            </div>
          </div>

          <div class="rounded-2xl bg-primary p-6 text-primary-foreground">
            <h2 class="mb-2 font-display text-xl font-semibold">
              Coordinación del programa
            </h2>
            <p class="mb-4 text-sm text-primary-foreground/80">
              {contacto.coordinador}
            </p>
            <div class="space-y-3">
              <a
                href={`mailto:${contacto.email}`}
                class="flex items-center gap-3 rounded-xl bg-primary-foreground/10 p-3 transition-colors hover:bg-primary-foreground/20"
              >
                <Mail className="h-5 w-5 flex-shrink-0" aria-hidden="true" />
                <span class="break-all text-sm">{contacto.email}</span>
              </a>
              <a
                href={contacto.telefonoHref}
                class="flex items-center gap-3 rounded-xl bg-primary-foreground/10 p-3 transition-colors hover:bg-primary-foreground/20"
              >
                <Phone className="h-5 w-5 flex-shrink-0" aria-hidden="true" />
                <span class="text-sm">{contacto.telefono}</span>
              </a>
            </div>
            <p class="mt-4 text-sm text-primary-foreground/60">
              {contacto.domicilio}
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
