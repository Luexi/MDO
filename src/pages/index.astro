---
import {
  ArrowRight,
  Award,
  BookOpen,
  CalendarClock,
  ClipboardCheck,
  GraduationCap,
  Lightbulb,
  PenLine,
  Users,
} from "lucide-react";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Button } from "@/components/ui/button";
import { etapaVigente, pasosAdmision } from "@/data/admision";
import { withBase } from "@/lib/paths";

const iconosPaso: Record<string, typeof ClipboardCheck> = {
  ClipboardCheck,
  PenLine,
  GraduationCap,
};

const beneficios = [
  {
    icon: GraduationCap,
    titulo: "Academia Rigurosa",
    descripcion:
      "Programa con reconocimiento de calidad, impartido por doctores con experiencia en investigación y consultoría.",
  },
  {
    icon: Users,
    titulo: "Networking Estratégico",
    descripcion:
      "Conecta con profesionales, empresarios y líderes del sector público y privado en la región.",
  },
  {
    icon: Lightbulb,
    titulo: "Innovación Aplicada",
    descripcion:
      "Desarrolla competencias para implementar modelos de gestión innovadores con impacto social.",
  },
];

const logosInstitucionales = [
  {
    src: "/assets/logos/logo-uagro.webp",
    alt: "Universidad Autónoma de Guerrero",
    width: 80,
    height: 80,
    clase: "h-16 w-auto md:h-20",
  },
  {
    src: "/assets/logos/logo-mdo.webp",
    alt: "Maestría en Dirección de Organizaciones",
    width: 80,
    height: 80,
    clase: "h-16 w-auto md:h-20",
  },
  {
    src: "/assets/logos/logo-fca.webp",
    alt: "Facultad de Contaduría y Administración",
    width: 142,
    height: 80,
    clase: "h-16 w-auto md:h-20",
  },
  {
    src: "/assets/logos/logo-secihti.webp",
    alt: "Secretaría de Ciencia, Humanidades, Tecnología e Innovación",
    width: 528,
    height: 64,
    clase: "h-12 w-auto md:h-16",
  },
];
---

<BaseLayout
  title="MDO UAGro | Inicio"
  description="Maestría en Dirección de Organizaciones de la UAGro. Convocatoria 2026, plan de estudios, núcleo académico y proceso de admisión."
>
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-hero-gradient"></div>
    <div class="absolute inset-0 bg-spotlight"></div>

    <div class="relative mx-auto max-w-4xl px-4 py-16 text-center md:py-24">
      <div
        class="animate-fade-in mb-8 inline-flex items-center gap-2 rounded-full border border-border bg-card/80 px-4 py-2 shadow-sm backdrop-blur-sm"
      >
        <Award className="h-4 w-4 text-primary" aria-hidden="true" />
        <span class="text-sm font-medium text-foreground">
          Con registro en el Programa Nacional de Posgrados
        </span>
      </div>

      <h1
        class="animate-fade-in mb-6 font-display text-4xl font-bold leading-tight text-foreground sm:text-5xl md:text-6xl"
      >
        Maestría en <span class="text-accent">Dirección</span>
        <br />
        de Organizaciones
      </h1>

      <p
        class="animate-fade-in mx-auto mb-10 max-w-2xl text-lg leading-relaxed text-muted-foreground md:text-xl"
      >
        Forma parte de la élite directiva. Desarrolla competencias para liderar,
        innovar y transformar organizaciones con impacto social en la región.
      </p>

      {/*
        Una sola accion principal. Antes competian dos botones de igual peso, uno
        azul y otro rojo, y el azul (Plan de Estudios) ademas sacaba al usuario
        del sitio hacia un PDF de Drive sin avisarlo.
      */}
      <div
        class="animate-fade-in flex flex-col items-center justify-center gap-4 sm:flex-row"
      >
        <a href={withBase("/convocatoria")}>
          <Button
            size="lg"
            className="gap-2 rounded-xl bg-destructive px-8 py-6 text-lg text-destructive-foreground hover:bg-destructive/90"
          >
            Convocatoria 2026
            <ArrowRight className="h-5 w-5" aria-hidden="true" />
          </Button>
        </a>
        <a href={withBase("/plan-estudios")}>
          <Button
            size="lg"
            variant="outline"
            className="gap-2 rounded-xl px-8 py-6 text-lg"
          >
            <BookOpen className="h-5 w-5" aria-hidden="true" />
            Plan de estudios
          </Button>
        </a>
      </div>
    </div>
  </section>

  {/*
    El proceso de admision es lo primero bajo el pliegue. Antes la portada no
    mostraba ni una fecha ni un requisito ni un paso: sus dos tarjetas
    destacadas eran "Objetivos" y "Núcleo Académico", de modo que quien llegaba
    preguntando "¿cómo entro?" no encontraba ninguna respuesta sin navegar.
  */}
  <section class="border-y border-border bg-card py-16" aria-labelledby="admision-titulo">
    <div class="mx-auto max-w-6xl px-4">
      <div class="mb-10 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <h2
            id="admision-titulo"
            class="font-display text-3xl font-bold text-foreground md:text-4xl"
          >
            Cómo ingresar
          </h2>
          <p class="mt-3 max-w-xl text-muted-foreground">
            El proceso de admisión para la generación 2026 tiene tres etapas.
          </p>
        </div>

        {/*
          Solo se muestra si hay una etapa confirmada como vigente. Sin dato
          verificado no se afirma nada: ver la nota de `src/data/admision.ts`
          sobre la discrepancia entre el calendario publicado y el cartel.
        */}
        {
          etapaVigente && (
            <div class="flex items-start gap-3 rounded-2xl border border-primary/20 bg-primary/5 p-4">
              <CalendarClock
                className="mt-0.5 h-5 w-5 flex-shrink-0 text-primary"
                aria-hidden="true"
              />
              <div>
                <p class="text-sm font-semibold text-primary">Etapa vigente</p>
                <p class="text-sm text-foreground">{etapaVigente.fecha}</p>
                <p class="text-sm text-muted-foreground">{etapaVigente.evento}</p>
              </div>
            </div>
          )
        }
      </div>

      <ol class="grid gap-6 md:grid-cols-3">
        {
          pasosAdmision.map((paso) => {
            const Icono = iconosPaso[paso.icono] ?? ClipboardCheck;
            return (
              <li class="flex h-full flex-col rounded-2xl border border-border bg-background p-6">
                <div class="mb-4 flex items-center gap-3">
                  <span
                    class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-primary font-semibold text-primary-foreground"
                    aria-hidden="true"
                  >
                    {paso.numero}
                  </span>
                  <Icono className="h-5 w-5 text-primary" aria-hidden="true" />
                </div>
                <h3 class="mb-2 font-display text-lg font-semibold text-foreground">
                  {paso.titulo}
                </h3>
                <p class="text-sm leading-relaxed text-muted-foreground">
                  {paso.descripcion}
                </p>
              </li>
            );
          })
        }
      </ol>

      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a
          href={withBase("/convocatoria")}
          class="inline-flex items-center gap-2 rounded font-medium text-accent hover:underline"
        >
          Ver requisitos y calendario completo
          <ArrowRight className="h-4 w-4" aria-hidden="true" />
        </a>
        <a
          href={withBase("/convocatoria#preguntas-frecuentes")}
          class="inline-flex items-center gap-2 rounded font-medium text-accent hover:underline"
        >
          Preguntas frecuentes
          <ArrowRight className="h-4 w-4" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <section class="py-16" aria-labelledby="beneficios-titulo">
    <div class="mx-auto max-w-6xl px-4">
      <div class="mb-10 text-center">
        <h2
          id="beneficios-titulo"
          class="mb-4 font-display text-3xl font-bold text-foreground md:text-4xl"
        >
          ¿Por qué elegir esta maestría?
        </h2>
        <p class="mx-auto max-w-2xl text-muted-foreground">
          Un programa diseñado para formar líderes con visión estratégica y
          compromiso social.
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-3">
        {
          beneficios.map((beneficio) => (
            <div class="group flex h-full flex-col rounded-2xl border border-border bg-card p-8 shadow-sm transition-shadow hover:shadow-md">
              <div class="mb-6 w-fit rounded-xl bg-primary/10 p-4 transition-colors group-hover:bg-primary">
                <beneficio.icon
                  className="h-8 w-8 text-primary transition-colors group-hover:text-primary-foreground"
                  aria-hidden="true"
                />
              </div>
              <h3 class="mb-3 font-display text-xl font-semibold text-foreground">
                {beneficio.titulo}
              </h3>
              <p class="leading-relaxed text-muted-foreground">
                {beneficio.descripcion}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="pb-16" aria-labelledby="explorar-titulo">
    <div class="mx-auto max-w-6xl px-4">
      <h2 id="explorar-titulo" class="sr-only">Explora el programa</h2>
      <div class="grid gap-8 md:grid-cols-2">
        <a
          href={withBase("/objetivos")}
          class="group relative overflow-hidden rounded-2xl bg-primary p-8 text-primary-foreground transition-shadow hover:shadow-xl"
        >
          <div class="relative z-10">
            <h3 class="mb-3 font-display text-2xl font-semibold">
              Objetivos y perfiles
            </h3>
            <p class="mb-4 text-primary-foreground/80">
              Objetivo general, metas del programa y perfiles de ingreso y
              egreso.
            </p>
            <span
              class="inline-flex items-center gap-2 font-medium transition-all group-hover:gap-3"
            >
              Explorar
              <ArrowRight className="h-4 w-4" aria-hidden="true" />
            </span>
          </div>
          <div
            class="absolute -bottom-8 -right-8 h-32 w-32 rounded-full bg-primary-foreground/10"
          >
          </div>
        </a>

        <a
          href={withBase("/nucleo-academico")}
          class="group relative overflow-hidden rounded-2xl bg-accent p-8 text-accent-foreground transition-shadow hover:shadow-xl"
        >
          <div class="relative z-10">
            <h3 class="mb-3 font-display text-2xl font-semibold">
              Núcleo académico
            </h3>
            <p class="mb-4 text-accent-foreground/80">
              Conoce a los doctores e investigadores que conforman nuestro
              claustro y sus líneas de trabajo.
            </p>
            <span
              class="inline-flex items-center gap-2 font-medium transition-all group-hover:gap-3"
            >
              Ver profesorado
              <ArrowRight className="h-4 w-4" aria-hidden="true" />
            </span>
          </div>
          <div
            class="absolute -bottom-8 -right-8 h-32 w-32 rounded-full bg-accent-foreground/10"
          >
          </div>
        </a>
      </div>
    </div>
  </section>

  {/*
    El muro de logos institucionales vive bajo el heroe, no dentro. Dentro del
    heroe empujaba el contenido y dejaba el logo de SECIHTI fuera de la primera
    pantalla en escritorio.
  */}
  <section class="border-t border-border py-12" aria-labelledby="respaldo-titulo">
    <div class="mx-auto max-w-6xl px-4">
      <h2
        id="respaldo-titulo"
        class="mb-8 text-center text-sm font-medium text-muted-foreground"
      >
        Respaldo institucional
      </h2>
      <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-6 opacity-80">
        {
          logosInstitucionales.map((logo) => (
            <img
              src={withBase(logo.src)}
              alt={logo.alt}
              width={logo.width}
              height={logo.height}
              loading="lazy"
              class={logo.clase}
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
