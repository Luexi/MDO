---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PageHeader } from "@/components/ui/PageHeader";
import GaleriaLightbox from "@/components/islands/GaleriaLightbox";
import { imagenesGaleria } from "@/data/galeria";
---

<BaseLayout
  title="MDO UAGro | Galería"
  description="Galería de eventos y actividades de la comunidad académica de la MDO UAGro."
>
  <PageHeader
    title="Galería"
    subtitle="Momentos destacados de nuestra comunidad académica"
  />

  <section class="py-12">
    <div class="mx-auto max-w-6xl px-4">
      <GaleriaLightbox imagenes={imagenesGaleria} client:idle />

      <p class="mt-10 rounded-2xl border border-border bg-muted/50 p-6 text-sm text-muted-foreground">
        Esta galería se actualiza periódicamente con imágenes de eventos,
        graduaciones y actividades del programa.
      </p>
    </div>
  </section>
</BaseLayout>
