---
import { ArrowRight, CheckCircle2, Target } from "lucide-react";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PageHeader } from "@/components/ui/PageHeader";
import ObjetivosTabs from "@/components/ObjetivosTabs.astro";
import { withBase } from "@/lib/paths";

const objetivosParticulares = [
  "Diagnosticar de forma crítica la situación operativa, financiera y estratégica de organizaciones públicas y privadas.",
  "Aplicar modelos avanzados de dirección y gestión para mejorar la eficiencia y la toma de decisiones en contextos complejos.",
  "Desarrollar investigación aplicada con intervención social para impulsar emprendimiento sostenible y empleo digno en la región.",
  "Vincular proyectos de titulación con sectores productivos e instituciones públicas para generar soluciones transferibles.",
];

const metas = [
  // El programa ya cuenta con registro en el Programa Nacional de Posgrados, de
  // modo que la meta 2026 es refrendarlo, no obtenerlo. La redaccion anterior
  // ("conseguir en 2026 el reconocimiento") contradecia la afirmacion de la
  // portada justo en el dato que mas pesa para un aspirante: la elegibilidad
  // para beca.
  "Refrendar en 2026 el reconocimiento en el Sistema Nacional de Posgrados (SNP) y sostener la elegibilidad del programa para becas.",
  "Actualizar en 2028 el plan de estudios con base en evaluación del SNP y seguimiento de egresadas y egresados.",
  "Consolidar el núcleo académico: 60% con experiencia profesional destacable (2027), 100% con Perfil Deseable PRODEP (2027) y 80% con distinción SNII (2028).",
  "Sostener productividad anual del núcleo académico: 90% en eventos de investigación LIES y al menos una publicación arbitrada o en libro reconocido por integrante.",
  "Alcanzar 70% de eficiencia terminal al cierre de 2026 y garantizar en 2026 movilidad académica o profesional para todo el estudiantado.",
  "Fortalecer en 2027 la infraestructura tecnológica y el acceso a recursos científicos y herramientas digitales para aprendizaje e investigación.",
];

const perfilIngreso = [
  "Egresadas y egresados de licenciaturas afines (administración, economía, contaduría, mercadotecnia, turismo y áreas relacionadas).",
  "Conocimientos básicos en administración, finanzas, economía, informática y estadística descriptiva.",
  "Habilidades de comunicación oral y escrita, trabajo colaborativo y gestión de información en entornos virtuales.",
  "Pensamiento analítico y orientación a la solución de problemas organizacionales.",
  "Interés por la investigación aplicada, la innovación y el uso de nuevas tecnologías.",
  "Comprensión lectora de textos académicos en inglés.",
  "Sentido ético, responsabilidad social y disposición para contribuir a la inclusión y equidad.",
];

const perfilEgreso = [
  "Diseñar, implementar y evaluar modelos de gestión e intervención para mejorar el desempeño organizacional.",
  "Dirigir organizaciones con pensamiento estratégico, liderazgo y enfoque ético.",
  "Desarrollar investigación aplicada y consultoría para resolver problemas complejos con impacto económico y social.",
  "Formular y evaluar proyectos de inversión y estrategias de crecimiento en distintos sectores.",
  "Integrar tecnologías de información e inteligencia artificial en procesos de decisión y gestión.",
  "Conformar y liderar equipos de alto desempeño en contextos multidisciplinarios.",
  "Impulsar emprendimiento sostenible, desarrollo regional y generación de empleo digno.",
  "Actuar con responsabilidad social, sentido crítico y compromiso con los valores universitarios.",
];
---

<BaseLayout
  title="MDO UAGro | Objetivos"
  description="Objetivo general, metas y perfiles de ingreso y egreso del programa MDO UAGro."
>
  <PageHeader
    title="Objetivos del programa"
    subtitle="Formando líderes con capacidades directivas y de investigación de alto nivel"
  />

  <section class="py-12">
    <div class="mx-auto max-w-4xl space-y-12 px-4">
      {/*
        El Objetivo General abre la pagina. Antes lo precedia el plan de estudios
        completo, con sus tablas por semestre, dentro de una pagina titulada
        "Objetivos del Programa": el contenido que daba nombre a la pagina
        aparecia despues de varias pantallas de otra cosa. El plan tiene ahora
        URL propia en /plan-estudios.
      */}
      <section
        aria-labelledby="objetivo-general"
        class="rounded-2xl border border-border bg-card p-8 shadow-sm"
      >
        <div class="flex items-start gap-4">
          <div class="rounded-xl bg-primary/10 p-3">
            <Target className="h-6 w-6 text-primary" aria-hidden="true" />
          </div>
          <div>
            <h2
              id="objetivo-general"
              class="mb-4 font-display text-2xl font-semibold text-foreground"
            >
              Objetivo general
            </h2>
            <p class="text-lg leading-relaxed text-muted-foreground">
              Formar personas con capacidades directivas y de investigación de
              alto nivel, competentes en el diseño, implementación y evaluación
              de modelos de gestión e intervención que optimicen el desempeño de
              las organizaciones públicas, privadas o no lucrativas, orientando
              resultados hacia la creación sostenible con impacto social en la
              región.
            </p>
          </div>
        </div>
      </section>

      <section aria-labelledby="objetivos-particulares">
        <h2
          id="objetivos-particulares"
          class="mb-6 flex items-center gap-3 font-display text-2xl font-semibold text-foreground"
        >
          <CheckCircle2 className="h-6 w-6 text-primary" aria-hidden="true" />
          Objetivos particulares
        </h2>
        <ol class="space-y-4">
          {
            objetivosParticulares.map((objetivo, index) => (
              <li class="flex items-start gap-4 rounded-xl border border-border bg-card p-4">
                <span
                  class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-primary/10 text-sm font-semibold text-primary"
                  aria-hidden="true"
                >
                  {index + 1}
                </span>
                <p class="leading-relaxed text-foreground/90">{objetivo}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section aria-labelledby="metas">
        <h2
          id="metas"
          class="mb-6 flex items-center gap-3 font-display text-2xl font-semibold text-foreground"
        >
          <Target className="h-6 w-6 text-primary" aria-hidden="true" />
          Metas del programa
        </h2>
        <ol class="space-y-4">
          {
            metas.map((meta, index) => (
              <li class="flex items-start gap-4 rounded-xl border border-border bg-card p-4">
                <span
                  class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-primary/10 text-sm font-semibold text-primary"
                  aria-hidden="true"
                >
                  {index + 1}
                </span>
                <p class="leading-relaxed text-foreground/90">{meta}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section aria-labelledby="perfiles">
        <h2
          id="perfiles"
          class="mb-6 font-display text-2xl font-semibold text-foreground"
        >
          Perfiles de ingreso y egreso
        </h2>
        <ObjetivosTabs perfilIngreso={perfilIngreso} perfilEgreso={perfilEgreso} />
      </section>

      <a
        href={withBase("/plan-estudios")}
        class="group flex items-center justify-between gap-4 rounded-2xl border border-border bg-card p-6 transition-shadow hover:shadow-md"
      >
        <div>
          <h2 class="font-display text-xl font-semibold text-foreground">
            Plan de estudios
          </h2>
          <p class="mt-1 text-sm text-muted-foreground">
            Unidades de aprendizaje por área de formación y por semestre.
          </p>
        </div>
        <ArrowRight
          className="h-5 w-5 flex-shrink-0 text-accent transition-transform group-hover:translate-x-1"
          aria-hidden="true"
        />
      </a>
    </div>
  </section>
</BaseLayout>
