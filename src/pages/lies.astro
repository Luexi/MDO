---
import { Briefcase, Target, Users } from "lucide-react";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PageHeader } from "@/components/ui/PageHeader";
import { withBase } from "@/lib/paths";

/*
 * El programa registra una sola linea de generacion y aplicacion del
 * conocimiento. El titulo y el copy estan en singular para que coincidan con el
 * contenido: antes la pagina se anunciaba en plural ("Líneas de Investigación",
 * "estas líneas de investigación") mostrando un unico elemento.
 */
const lineas = [
  {
    id: "1",
    titulo: "Gestión y Desarrollo Empresarial",
    descripcion:
      "Línea de investigación enfocada en el estudio y mejora de los procesos de gestión en organizaciones empresariales, incluyendo estrategias de crecimiento, innovación, competitividad y sustentabilidad.",
    areas: [
      "Estrategia empresarial y competitividad",
      "Innovación y emprendimiento",
      "Finanzas corporativas",
      "Mercadotecnia estratégica",
      "Gestión del talento humano",
    ],
    icon: Briefcase,
  },
];

const esSingular = lineas.length === 1;
---

<BaseLayout
  title="MDO UAGro | Línea de investigación"
  description="Línea de generación y aplicación del conocimiento de la Maestría en Dirección de Organizaciones."
>
  <PageHeader
    title={
      esSingular
        ? "Línea de investigación e incidencia social"
        : "Líneas de investigación e incidencia social"
    }
    subtitle="Generación y aplicación del conocimiento en la Maestría en Dirección de Organizaciones"
  />

  <section class="py-12">
    <div class="mx-auto max-w-5xl px-4">
      <div class="space-y-8">
        {
          lineas.map((linea) => (
            <article class="rounded-2xl border border-border bg-card p-8 shadow-sm">
              <div class="flex flex-col items-start gap-6 sm:flex-row">
                <div class="flex-shrink-0 rounded-xl bg-primary/10 p-4">
                  <linea.icon className="h-8 w-8 text-primary" aria-hidden="true" />
                </div>
                <div class="flex-1">
                  <h2 class="mb-3 font-display text-2xl font-semibold text-foreground">
                    {linea.titulo}
                  </h2>
                  <p class="mb-6 leading-relaxed text-muted-foreground">
                    {linea.descripcion}
                  </p>

                  <h3 class="mb-3 flex items-center gap-2 font-semibold text-foreground">
                    <Target className="h-4 w-4 text-accent" aria-hidden="true" />
                    Áreas de estudio
                  </h3>
                  <ul class="flex flex-wrap gap-2">
                    {linea.areas.map((area) => (
                      <li class="rounded-lg bg-muted px-3 py-1.5 text-sm text-foreground/80">
                        {area}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <div class="mt-12 rounded-2xl bg-primary/5 p-8 text-center">
        <Users className="mx-auto mb-4 h-12 w-12 text-primary" aria-hidden="true" />
        <h2 class="mb-2 font-display text-xl font-semibold text-foreground">
          ¿Te interesa investigar con nosotros?
        </h2>
        {/*
          `text-foreground/80` y no `text-muted-foreground`: sobre `bg-primary/5`
          ese token cae a 4.46:1, por debajo del minimo AA. Ver la nota de
          `--muted-foreground` en global.css.
        */}
        <p class="mx-auto max-w-2xl text-foreground/80">
          El núcleo académico está conformado por investigadoras e
          investigadores activos que pueden dirigir tu proyecto de tesis en
          {esSingular ? " esta línea." : " estas líneas."}
        </p>
        <a
          href={withBase("/nucleo-academico")}
          class="mt-4 inline-flex rounded-lg font-medium text-accent hover:underline"
        >
          Conocer al núcleo académico
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
