---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PageHeader } from "@/components/ui/PageHeader";
import { ProfesorCard } from "@/components/cards/ProfesorCard";
import { profesores } from "@/data/profesores";
---

<BaseLayout
  title="MDO UAGro | Núcleo académico"
  description="Profesorado de la Maestría en Dirección de Organizaciones, con sus líneas de investigación y producción académica."
>
  <PageHeader
    title="Núcleo académico"
    subtitle="Profesorado del programa y sus líneas de generación y aplicación del conocimiento"
  />

  <section class="py-12" aria-labelledby="claustro">
    <div class="mx-auto max-w-7xl px-4">
      {/*
        Encabezado de seccion explicito. Sin el, la pagina saltaba de `h1` a los
        `h3` de las tarjetas, y quedaba sin ningun `h2` en toda su estructura.
      */}
      <h2 id="claustro" class="mb-6 text-sm font-medium text-muted-foreground">
        {profesores.length} integrantes del núcleo académico
      </h2>

      <ul class="grid auto-rows-fr grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {
          profesores.map((profesor) => (
            <li class="h-full">
              <ProfesorCard profesor={profesor} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
