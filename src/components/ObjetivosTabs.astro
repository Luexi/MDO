---
import { CheckCircle2, GraduationCap, UserCheck } from "lucide-react";
import TabGroup from "@/components/ui/TabGroup.astro";

interface Props {
  perfilIngreso: string[];
  perfilEgreso: string[];
}

const { perfilIngreso, perfilEgreso } = Astro.props;
---

<TabGroup
  grupo="perfiles"
  etiqueta="Perfiles de ingreso y egreso"
  tabs={[
    { id: "ingreso", label: "Perfil de Ingreso", icono: UserCheck },
    { id: "egreso", label: "Perfil de Egreso", icono: GraduationCap },
  ]}
>
  <Fragment slot="panel-1">
    <div class="rounded-2xl border border-border bg-card p-6">
      <h3 class="font-display text-xl font-semibold text-foreground mb-4">
        Requisitos y competencias de ingreso
      </h3>
      <p class="text-muted-foreground mb-6">
        Podrán ingresar al programa egresadas y egresados de licenciaturas
        afines con las siguientes competencias deseables:
      </p>
      <ul class="space-y-3">
        {
          perfilIngreso.map((item) => (
            <li class="flex items-start gap-3">
              <CheckCircle2
                className="h-5 w-5 text-primary flex-shrink-0 mt-0.5"
                aria-hidden="true"
              />
              <span class="text-foreground/90">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </Fragment>

  <Fragment slot="panel-2">
    <div class="rounded-2xl border border-border bg-card p-6">
      <h3 class="font-display text-xl font-semibold text-foreground mb-4">
        Competencias del egresado
      </h3>
      <p class="text-muted-foreground mb-6">
        El egresado de la MDO será un profesional capacitado para liderar,
        innovar y transformar organizaciones de cualquier sector, contribuyendo
        al desarrollo sostenible y al bienestar social. Será capaz de:
      </p>
      <ul class="space-y-3">
        {
          perfilEgreso.map((item) => (
            <li class="flex items-start gap-3">
              <CheckCircle2
                className="h-5 w-5 text-accent flex-shrink-0 mt-0.5"
                aria-hidden="true"
              />
              <span class="text-foreground/90">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </Fragment>
</TabGroup>
