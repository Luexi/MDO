---
import { CheckCircle2, LayoutGrid, Table2 } from "lucide-react";
import TabGroup from "@/components/ui/TabGroup.astro";
import type { PlanAreaItem, PlanOptativa, PlanSemestre } from "@/data/planEstudios";

interface Props {
  areas: PlanAreaItem[];
  semestres: PlanSemestre[];
  optativas: PlanOptativa[];
}

const { areas, semestres, optativas } = Astro.props;
---

<TabGroup
  grupo="plan"
  etiqueta="Vistas del plan de estudios"
  tabs={[
    { id: "area", label: "Área de formación", icono: LayoutGrid },
    { id: "semestre", label: "Semestre", icono: Table2 },
  ]}
>
  <Fragment slot="panel-1">
    <div class="grid gap-4 md:grid-cols-3">
      {
        areas.map((area) => (
          <article class="h-full rounded-2xl border border-border bg-card p-5">
            <h3 class="font-display text-lg font-semibold text-foreground mb-4">
              {area.area}
            </h3>
            <ul class="space-y-2.5">
              {area.unidades.map((unidad) => (
                <li class="flex items-start gap-2.5">
                  <CheckCircle2
                    className="h-4 w-4 text-primary mt-0.5 flex-shrink-0"
                    aria-hidden="true"
                  />
                  <span class="text-sm text-foreground/90">{unidad}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </Fragment>

  <Fragment slot="panel-2">
    <div class="space-y-5">
      {
        semestres.map((semestre) => (
          <section class="rounded-2xl border border-border bg-card p-4 sm:p-5">
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <h3 class="font-display text-lg font-semibold text-foreground mr-1">
                Semestre {semestre.semestre}
              </h3>
              <span class="inline-flex items-center rounded-full bg-primary/10 px-2.5 py-1 text-xs font-medium text-primary">
                Total de horas: {semestre.totalTh}
              </span>
              <span class="inline-flex items-center rounded-full bg-accent/10 px-2.5 py-1 text-xs font-medium text-accent">
                Créditos: {semestre.totalCred}
              </span>
            </div>
            <div class="overflow-x-auto">
              <table class="min-w-[560px] w-full text-sm">
                <caption class="sr-only">
                  Unidades de aprendizaje del semestre {semestre.semestre}, con
                  total de horas y créditos.
                </caption>
                <thead>
                  <tr class="border-b border-border text-muted-foreground">
                    <th scope="col" class="text-left py-2 pr-3 font-medium">
                      Unidad de aprendizaje
                    </th>
                    <th scope="col" class="text-right py-2 px-3 font-medium">
                      Total de horas
                    </th>
                    <th scope="col" class="text-right py-2 pl-3 font-medium">
                      Total/Créditos
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {semestre.rows.map((row) => (
                    <tr class="border-b border-border/70 last:border-b-0">
                      <td class="py-2.5 pr-3 text-foreground/90">{row.unidad}</td>
                      <td class="py-2.5 px-3 text-right text-foreground/90">
                        {row.th}
                      </td>
                      <td class="py-2.5 pl-3 text-right text-foreground/90">
                        {row.totalCred}
                      </td>
                    </tr>
                  ))}
                </tbody>
                <tfoot>
                  <tr class="border-t border-border">
                    <td class="pt-3 pr-3 font-semibold text-foreground">
                      Total del semestre
                    </td>
                    <td class="pt-3 px-3 text-right font-semibold text-foreground">
                      {semestre.totalTh}
                    </td>
                    <td class="pt-3 pl-3 text-right font-semibold text-foreground">
                      {semestre.totalCred}
                    </td>
                  </tr>
                </tfoot>
              </table>
            </div>
          </section>
        ))
      }

      <section class="rounded-2xl border border-border bg-card p-4 sm:p-5">
        <h3 class="font-display text-lg font-semibold text-foreground mb-3">
          Unidades de aprendizaje optativas
        </h3>
        <div class="overflow-x-auto">
          <table class="min-w-[560px] w-full text-sm">
            <caption class="sr-only">
              Lista de unidades de aprendizaje optativas, con total de horas y
              créditos.
            </caption>
            <thead>
              <tr class="border-b border-border text-muted-foreground">
                <th scope="col" class="text-left py-2 pr-3 font-medium">
                  Unidad de aprendizaje
                </th>
                <th scope="col" class="text-right py-2 px-3 font-medium">
                  Total de horas
                </th>
                <th scope="col" class="text-right py-2 pl-3 font-medium">
                  Total/Créditos
                </th>
              </tr>
            </thead>
            <tbody>
              {
                optativas.map((optativa) => (
                  <tr class="border-b border-border/70 last:border-b-0">
                    <td class="py-2.5 pr-3 text-foreground/90">
                      {optativa.unidad}
                    </td>
                    <td class="py-2.5 px-3 text-right text-foreground/90">
                      {optativa.th}
                    </td>
                    <td class="py-2.5 pl-3 text-right text-foreground/90">
                      {optativa.totalCred}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </Fragment>
</TabGroup>
