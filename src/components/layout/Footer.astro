---
import { Facebook, Mail, MapPin, Phone } from "lucide-react";
import { contacto, redesSociales } from "@/data/contacto";
import { navGrupos } from "@/data/navegacion";
import { withBase } from "@/lib/paths";

const anio = new Date().getFullYear();
---

<footer class="bg-primary text-primary-foreground">
  <div class="mx-auto max-w-7xl px-4 py-12">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-5">
      <div class="lg:col-span-2">
        {/*
          Los logos van sobre una superficie clara en lugar de invertidos.
          El filtro `brightness-0 invert` que se usaba antes colapsaba el escudo
          de la UAGro, que tiene detalle interior fino, en un disco blanco
          solido: el identificador principal de la institucion aparecia como una
          mancha en todas las paginas del sitio.
        */}
        <div
          class="mb-5 inline-flex flex-wrap items-center gap-4 rounded-2xl bg-primary-foreground px-4 py-3"
        >
          <img
            src={withBase("/assets/logos/logo-uagro.webp")}
            alt="Universidad Autónoma de Guerrero"
            width="48"
            height="48"
            loading="lazy"
            class="h-12 w-auto"
          />
          <img
            src={withBase("/assets/logos/logo-fca.webp")}
            alt="Facultad de Contaduría y Administración"
            width="85"
            height="48"
            loading="lazy"
            class="h-12 w-auto"
          />
          <img
            src={withBase("/assets/logos/logo-mdo.webp")}
            alt="Maestría en Dirección de Organizaciones"
            width="48"
            height="48"
            loading="lazy"
            class="h-12 w-auto"
          />
        </div>

        <p class="max-w-md text-sm leading-relaxed text-primary-foreground/80">
          Maestría en Dirección de Organizaciones de la Universidad Autónoma de
          Guerrero. Formación directiva y de investigación aplicada con impacto
          social en la región.
        </p>
      </div>

      {
        navGrupos.map((grupo) => (
          <nav aria-label={grupo.label}>
            <h2 class="mb-4 font-display text-lg font-semibold">{grupo.label}</h2>
            <ul class="space-y-2">
              {grupo.items.map((item) => (
                <li>
                  <a
                    href={withBase(item.href)}
                    class="rounded text-sm text-primary-foreground/80 transition-colors hover:text-primary-foreground"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="mt-10 border-t border-primary-foreground/20 pt-8">
      <div class="grid gap-8 md:grid-cols-2">
        <div>
          <h2 class="mb-4 font-display text-lg font-semibold">Contacto</h2>
          <ul class="space-y-3">
            <li class="flex items-start gap-2">
              <MapPin
                className="mt-0.5 h-5 w-5 flex-shrink-0"
                aria-hidden="true"
              />
              <span class="text-sm text-primary-foreground/80">
                {contacto.domicilio}
              </span>
            </li>
            <li class="flex items-center gap-2">
              <Phone className="h-5 w-5 flex-shrink-0" aria-hidden="true" />
              <a
                href={contacto.telefonoHref}
                class="rounded text-sm text-primary-foreground/80 transition-colors hover:text-primary-foreground"
              >
                {contacto.telefono}
              </a>
            </li>
            <li class="flex items-center gap-2">
              <Mail className="h-5 w-5 flex-shrink-0" aria-hidden="true" />
              <a
                href={`mailto:${contacto.email}`}
                class="break-all rounded text-sm text-primary-foreground/80 transition-colors hover:text-primary-foreground"
              >
                {contacto.email}
              </a>
            </li>
          </ul>
          <p class="mt-3 text-sm text-primary-foreground/60">
            {contacto.horario}
          </p>
        </div>

        <div class="md:text-right">
          <h2 class="mb-4 font-display text-lg font-semibold">Síguenos</h2>
          {/*
            Solo se enlazan cuentas reales del programa. Twitter y LinkedIn
            apuntaban a las portadas genericas de esas redes, no a perfiles
            propios, asi que se retiraron.
          */}
          <div class="flex gap-3 md:justify-end">
            {
              redesSociales.map((red) => (
                <a
                  href={red.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-lg bg-primary-foreground/10 p-2 transition-colors hover:bg-primary-foreground/20"
                  aria-label={`${red.nombre} de la MDO UAGro, se abre en una pestaña nueva`}
                >
                  <Facebook className="h-5 w-5" aria-hidden="true" />
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <p class="mt-10 text-sm text-primary-foreground/60">
        &copy; {anio} Universidad Autónoma de Guerrero. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>
