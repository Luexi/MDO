---
import { ChevronDown, Menu, X } from "lucide-react";
import {
  ctaPrincipal,
  esRutaActiva,
  grupoActivo,
  navGrupos,
} from "@/data/navegacion";
import { withBase } from "@/lib/paths";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const inicioActivo = esRutaActiva("/", currentPath);
---

<header class="fixed top-4 left-1/2 z-50 w-[95%] max-w-6xl -translate-x-1/2">
  <nav
    aria-label="Navegación principal"
    class="rounded-2xl border border-border bg-card/90 px-4 py-3 shadow-lg backdrop-blur-md"
  >
    <div class="flex items-center justify-between gap-3">
      <a
        href={withBase("/")}
        class="flex flex-shrink-0 items-center gap-3 rounded-lg"
        aria-label="MDO UAGro, ir al inicio"
      >
        <img
          src={withBase("/assets/logos/logo-uagro.webp")}
          alt="Universidad Autónoma de Guerrero"
          width="40"
          height="40"
          class="h-10 w-auto"
        />
        <img
          src={withBase("/assets/logos/logo-mdo.webp")}
          alt="Maestría en Dirección de Organizaciones"
          width="48"
          height="48"
          class="hidden h-12 w-auto sm:block"
        />
      </a>

      <div class="hidden items-center gap-1 lg:flex">
        <a
          href={withBase("/")}
          aria-current={inicioActivo ? "page" : undefined}
          class:list={[
            "rounded-lg px-3 py-2 text-sm font-medium transition-colors",
            inicioActivo
              ? "bg-primary text-primary-foreground"
              : "text-foreground/80 hover:bg-muted hover:text-foreground",
          ]}
        >
          Inicio
        </a>

        {
          navGrupos.map((grupo) => {
            const activo = grupoActivo(grupo, currentPath);
            return (
              <div class="relative" data-nav-grupo>
                <button
                  type="button"
                  data-nav-boton
                  aria-expanded="false"
                  aria-controls={`nav-panel-${grupo.id}`}
                  class:list={[
                    "flex items-center gap-1 rounded-lg px-3 py-2 text-sm font-medium transition-colors",
                    activo
                      ? "bg-primary text-primary-foreground"
                      : "text-foreground/80 hover:bg-muted hover:text-foreground",
                  ]}
                >
                  {grupo.label}
                  <ChevronDown className="h-4 w-4" aria-hidden="true" />
                </button>

                <div
                  id={`nav-panel-${grupo.id}`}
                  data-nav-panel
                  hidden
                  class="absolute left-0 top-full z-10 mt-2 w-80 rounded-2xl border border-border bg-card p-2 shadow-xl"
                >
                  <ul class="flex flex-col">
                    {grupo.items.map((item) => {
                      const itemActivo = esRutaActiva(item.href, currentPath);
                      return (
                        <li>
                          <a
                            href={withBase(item.href)}
                            aria-current={itemActivo ? "page" : undefined}
                            class:list={[
                              "block rounded-xl px-3 py-2.5 transition-colors",
                              itemActivo
                                ? "bg-muted"
                                : "hover:bg-muted focus-visible:bg-muted",
                            ]}
                          >
                            <span class="block text-sm font-medium text-foreground">
                              {item.label}
                            </span>
                            <span class="mt-0.5 block text-xs text-muted-foreground">
                              {item.descripcion}
                            </span>
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              </div>
            );
          })
        }
      </div>

      <div class="flex flex-shrink-0 items-center gap-2">
        {/*
          Visible tambien en movil. Antes llevaba `hidden sm:block`, asi que en
          telefono, que es el dispositivo mayoritario de esta audiencia, la
          accion de conversion principal desaparecia de la barra y exigia abrir
          primero el menu.
        */}
        <a
          href={withBase(ctaPrincipal.href)}
          class="inline-flex h-11 items-center justify-center whitespace-nowrap rounded-xl bg-destructive px-4 text-sm font-semibold text-destructive-foreground transition-colors hover:bg-destructive/90"
        >
          {ctaPrincipal.label}
        </a>

        {/*
          `p-2.5` sobre un icono de 24px da 44x44, el objetivo tactil comodo.
          Con `p-2` quedaba en 40px, y en movil este boton es la unica puerta a
          los doce destinos del sitio.
        */}
        <button
          type="button"
          data-menu-boton
          aria-expanded="false"
          aria-controls="menu-movil"
          aria-label="Abrir o cerrar el menú de navegación"
          class="rounded-lg p-2.5 transition-colors hover:bg-muted lg:hidden"
        >
          <span data-icono-menu>
            <Menu className="h-6 w-6" aria-hidden="true" />
          </span>
          <span data-icono-cerrar class="hidden">
            <X className="h-6 w-6" aria-hidden="true" />
          </span>
        </button>
      </div>
    </div>

    <div
      id="menu-movil"
      data-menu-movil
      hidden
      class="mt-4 max-h-[70vh] overflow-y-auto border-t border-border pt-4 lg:hidden"
    >
      <a
        href={withBase("/")}
        aria-current={inicioActivo ? "page" : undefined}
        class:list={[
          "block rounded-xl px-4 py-3 text-sm font-medium transition-colors",
          inicioActivo
            ? "bg-primary text-primary-foreground"
            : "text-foreground/80 hover:bg-muted",
        ]}
      >
        Inicio
      </a>

      {
        navGrupos.map((grupo) => (
          <section class="mt-4 first:mt-2">
            <h2 class="px-4 pb-1 text-xs font-semibold uppercase tracking-wide text-muted-foreground">
              {grupo.label}
            </h2>
            <ul class="flex flex-col">
              {grupo.items.map((item) => {
                const itemActivo = esRutaActiva(item.href, currentPath);
                return (
                  <li>
                    <a
                      href={withBase(item.href)}
                      aria-current={itemActivo ? "page" : undefined}
                      class:list={[
                        "block rounded-xl px-4 py-3 text-sm font-medium transition-colors",
                        itemActivo
                          ? "bg-primary text-primary-foreground"
                          : "text-foreground/80 hover:bg-muted",
                      ]}
                    >
                      {item.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }
    </div>
  </nav>
</header>
