---
import Navbar from "@/components/layout/Navbar.astro";
import Footer from "@/components/layout/Footer.astro";
import { withBase } from "@/lib/paths";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noFooter?: boolean;
}

const siteName = "UAGRO";
const alternateSiteName = "MDO UAGro";
const organizationName = "Universidad Autónoma de Guerrero";

const {
  title = "MDO UAGro | Maestría en Dirección de Organizaciones",
  description = "Sitio oficial de la Maestría en Dirección de Organizaciones de la UAGro.",
  noFooter = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
// `Astro.site` viene de `astro.config.mjs`, que lo toma de PUBLIC_SITE_URL.
const siteOrigin = Astro.site?.toString() ?? "http://localhost:8080";
const canonicalUrl = new URL(currentPath, siteOrigin).toString();
const homeUrl = new URL(withBase("/"), siteOrigin).toString();
const logoUrl = new URL(withBase("/assets/logos/logo-uagro.webp"), siteOrigin).toString();
const ogImageUrl = new URL(withBase("/assets/logos/logo-mdo.webp"), siteOrigin).toString();

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  url: homeUrl,
  name: siteName,
  alternateName: alternateSiteName,
  inLanguage: "es-MX",
  publisher: {
    "@type": "Organization",
    name: organizationName,
    url: homeUrl,
    logo: logoUrl,
  },
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: organizationName,
  alternateName: siteName,
  url: homeUrl,
  logo: logoUrl,
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="MDO UAGro" />
    <meta name="application-name" content={siteName} />
    <meta name="apple-mobile-web-app-title" content={siteName} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="manifest" href={withBase("/site.webmanifest")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
      />
    </noscript>
    {
      currentPath === withBase("/") && (
        <>
          <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(websiteSchema)}
          />
          <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(organizationSchema)}
          />
        </>
      )
    }
    <title>{title}</title>
  </head>
  <body>
    <a href="#contenido-principal" class="sr-only-focusable">
      Saltar al contenido principal
    </a>

    <div class="flex min-h-screen flex-col bg-background">
      <Navbar currentPath={currentPath} />
      <main id="contenido-principal" class="flex-1 pt-24">
        <slot />
      </main>
      {!noFooter && <Footer />}
    </div>

    <script>
      import { initNavbar } from "@/scripts/navbar";
      import { initTabs } from "@/scripts/tabs";

      initNavbar();
      initTabs();
    </script>
  </body>
</html>
